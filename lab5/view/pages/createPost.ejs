<head>
    <%- include('../partial/head'); %>
</head>

<header>
    <%- include('../partial/header'); %>
  </header>
<section class="bg-white dark:bg-gray-900 p-2">
    <div class="py-8 px-4 mx-auto max-w-screen-md lg:py-16 lg:px-6">
        <div class="mx-auto max-w-screen-sm text-center lg:mb-10 mb-6">
            <h2 class="mb-4 text-3xl lg:text-4xl tracking-tight font-extrabold text-gray-900 dark:text-white">
                Create a New Post
            </h2>
        </div> 

        <form id="form" class="bg-white shadow-md rounded-lg p-6 dark:bg-gray-800">
          

            <div class="mb-4">
                <label for="title" class="block text-gray-700 dark:text-white font-bold mb-2">Title</label>
                <input type="text" id="title" name="title" 
                    class="w-full px-3 py-2 border rounded-lg focus:ring focus:ring-indigo-300 dark:bg-gray-700 dark:text-white" 
                    placeholder="Enter post title" required>
            </div>

            <div class="mb-4">
                <label for="content" class="block text-gray-700 dark:text-white font-bold mb-2">Content</label>
                <textarea id="content" name="content" rows="4"
                    class="w-full px-3 py-2 border rounded-lg focus:ring focus:ring-indigo-300 dark:bg-gray-700 dark:text-white"
                    placeholder="Write something..." required></textarea>
            </div>

            <span id="error" class="border-e-red-400 text-red-400 block">

            </span>

            <button  class="cursor-pointer bg-blue-500 text-white font-extrabold py-2 px-4 rounded-md mt-4">  Create Post </button>
               
            </button>
        </form>
    </div>
</section>
<script>
    const form = document.getElementById("form");
    const addPost =  async(e)=>{
        e.preventDefault();
        const title= document.getElementById("title").value;
        const content= document.getElementById("content").value;

        const res = await fetch("/post/create",{
            method:"POST",
            headers:{
                "Content-Type":"application/json",
            },
            body:JSON.stringify({title,content})
        });
        const data = await res.json();

        if(res.status=201){
            console.log("asdsad");
            
            window.location.href = "/post/posts"
        }else{
            document.getElementById("error").innerHTML = data.message;
        }

    
    }


    form.addEventListener("submit",addPost);

</script>
